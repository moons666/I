-- Teleporte ao clicar (corrigido)
local teleportEnabled = false
local teleportConnection

local function enableTeleport()
	if teleportConnection and teleportConnection.Connected then return end
	teleportConnection = Mouse.Button1Down:Connect(function()
		if UserInputService:GetFocusedTextBox() then return end
		local hit = Mouse.Hit
		if hit then
			local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.CFrame = CFrame.new(hit.p + Vector3.new(0, 5, 0))
			end
		end
	end)
end

local function disableTeleport()
	if teleportConnection then
		teleportConnection:Disconnect()
		teleportConnection = nil
	end
end

newButton("Teleporte", function(on)
	teleportEnabled = on
	if teleportEnabled then enableTeleport() else disableTeleport() end
end)

